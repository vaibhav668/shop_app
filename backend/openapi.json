    "/api/v1/me/devices/{token}": {
      "delete": {
        "operationId": "remove_device_api_v1_me_devices__token__delete",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
