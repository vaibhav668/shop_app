          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Liveness: the process is up.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
