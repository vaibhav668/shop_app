# Copy to .env and fill in. Never commit .env.
# Variables marked (Phase N) are read once that phase lands; they can stay blank until then.

APP_ENV=local
LOG_LEVEL=INFO

# Database (local role/databases come from scripts/create_local_db.sql)
DATABASE_URL=postgresql+psycopg://shop:shop@localhost:5432/shop
TEST_DATABASE_URL=postgresql+psycopg://shop:shop@localhost:5432/shop_test

# Comma-separated origins allowed to call the API from a browser (admin dashboard, Expo web preview)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
SHOP_TIMEZONE=Asia/Kolkata

# Auth
JWT_SECRET=change-me-to-64-random-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60
# Comma-separated OAuth client IDs whose Google ID tokens are accepted (web client ID)
GOOGLE_ALLOWED_CLIENT_IDS=
ADMIN_COOKIE_SECURE=false
# Local-only email sign-in (no Google) for trying the app before OAuth is set up. Never in production.
DEV_LOGIN_ENABLED=true

# Image storage (Phase 3): local | cloudinary | s3
STORAGE_PROVIDER=local
CLOUDINARY_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Payments (Phase 8): fake | razorpay
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Push notifications (Phase 10): fake | fcm
PUSH_PROVIDER=fake
FIREBASE_CREDENTIALS_JSON_BASE64=

# Monitoring (optional)
SENTRY_DSN=
