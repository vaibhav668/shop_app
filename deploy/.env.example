# Production settings for deploy/docker-compose.yml. Copy to deploy/.env (never commit it).
# Secrets live only on the server.

# Your domain. The kit serves api.<DOMAIN>, admin.<DOMAIN> and shop.<DOMAIN>;
# point all three DNS A records at this server first.
DOMAIN=badabazar.in
# Certificate notices from Let's Encrypt go here.
ACME_EMAIL=you@example.com

# Database password: generate one, e.g.  openssl rand -hex 24
POSTGRES_PASSWORD=
# Token signing secret, 32+ random characters:  openssl rand -hex 48
JWT_SECRET=

# Google sign-in. The *web* client's ID (used by the shop web app), and every client ID whose
# tokens the API accepts (web + Android), comma-separated. See docs/SETUP_GOOGLE_SIGNIN.md.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ALLOWED_CLIENT_IDS=

# Who becomes a shop admin on Google sign-in (comma-separated).
ADMIN_EMAILS=

# Product photos. cloudinary://<api_key>:<api_secret>@<cloud_name>
STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=

# Push notifications through Firebase. Put the service-account key at this path on the server.
PUSH_PROVIDER=fcm
FIREBASE_KEY_PATH=./secrets/firebase.json

# Optional
APP_ENV=production
WEB_CONCURRENCY=2
BACKUP_KEEP_DAYS=14
