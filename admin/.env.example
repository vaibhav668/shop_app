# VITE_* values are bundled into the browser app: public identifiers only.
VITE_API_URL=http://localhost:8000/api/v1
# Google OAuth web client ID (Phase 2)
VITE_GOOGLE_CLIENT_ID=

# The customer shop (the app's web build); non-admins who sign in here are sent there.
VITE_SHOP_URL=http://localhost:8081
