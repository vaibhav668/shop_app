# EXPO_PUBLIC_* values are embedded in the app bundle: public identifiers only, never secrets.

# Backend base URL. On a physical phone use your PC's LAN IP, e.g. http://192.168.1.20:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google OAuth *web* client ID (Phase 2)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
